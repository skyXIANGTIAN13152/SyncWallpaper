<Window x:Class="SyncWallpaper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SyncWallpaper" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" AllowsTransparency="True" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="{StaticResource TextPrimary}">
    <Window.Resources>
        <LinearGradientBrush x:Key="NebulaGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#563B7BFF" Offset="0"/>
            <GradientStop Color="#18256DCC" Offset="0.55"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="EyeGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6BF3FF" Offset="0"/>
            <GradientStop Color="#25B7FF" Offset="0.55"/>
            <GradientStop Color="#697CFF" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassCardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>
        <Style x:Key="WindowChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#55325E77"/>
            <Setter Property="BorderBrush" Value="#6E8AA8C8"/>
        </Style>
        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowChromeButton}">
            <Setter Property="Background" Value="#553D304C"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse x:Name="NebulaGlowTop" Width="640" Height="640" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-260,-190,0" Fill="{StaticResource NebulaGlow}" Opacity="0.55" IsHitTestVisible="False"/>
        <Ellipse x:Name="NebulaGlowBottom" Width="440" Height="440" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-220,0,0,-190" Fill="{StaticResource NebulaGlow}" Opacity="0.3" IsHitTestVisible="False"/>

        <Border Margin="10" Background="{StaticResource WindowSurface}" BorderBrush="{StaticResource GlassBorder}"
                BorderThickness="1" CornerRadius="24" Padding="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#47739BBA" BorderThickness="0,0,0,1"
                        Background="{StaticResource HeaderBackground}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="24,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="46" Height="46" Margin="0,0,12,0">
                                <Ellipse Fill="#20347DAD" Stroke="#8B4EE8FF" StrokeThickness="1" Margin="2"/>
                                <Ellipse Stroke="{StaticResource Cyan}" StrokeThickness="1.8" Margin="7"/>
                                <Path Data="M5,23 C13,12 33,12 41,23 C33,34 13,34 5,23 Z"
                                      Fill="{StaticResource EyeGradient}" Stroke="{StaticResource Cyan}" StrokeThickness="1.2"/>
                                <Ellipse Width="14" Height="14" Fill="#101A35" Stroke="{StaticResource Cyan}" StrokeThickness="1.4"/>
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Cyan}"/>
                                <Ellipse Width="2" Height="2" Fill="White" Margin="2,0,0,2"/>
                            </Grid>
                            <StackPanel>
                                <TextBlock Text="SyncWallpaper" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Multi-monitor wallpaper detection, matching and recovery" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#55325E77" BorderBrush="#8A35DFF7" BorderThickness="1" CornerRadius="14" Padding="11,5">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Cyan}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusBadge" Text="Starting" Foreground="{StaticResource Cyan}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource WindowChromeButton}" Margin="14,0,0,0" Click="Minimize_Click" ToolTip="Minimize">
                                <Path Data="M3,8 H13" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.6"/>
                            </Button>
                            <Button Style="{StaticResource WindowChromeButton}" Click="Maximize_Click" ToolTip="Maximize or restore">
                                <Path Data="M3,3 H13 V13 H3 Z" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.45" Fill="Transparent"/>
                            </Button>
                            <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="Hide to tray">
                                <Path Data="M3,3 L13,13 M13,3 L3,13" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.6"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="224"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#B5081428" BorderBrush="#47739BBA" BorderThickness="0,0,1,0">
                        <StackPanel Margin="12,22">
                            <TextBlock Text="WALLPAPER" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="12,0,0,10"/>
                            <Button Tag="Overview" Style="{StaticResource NavButton}" Content="⌂  Overview" Click="Nav_Click"/>
                            <Button Tag="Monitors" Style="{StaticResource NavButton}" Content="▣  Monitor Identification" Click="Nav_Click"/>
                            <Button Tag="Library" Style="{StaticResource NavButton}" Content="▧  Wallpaper Library" Click="Nav_Click"/>
                            <Button Tag="Profiles" Style="{StaticResource NavButton}" Content="⌁  Wallpaper Profiles" Click="Nav_Click"/>
                            <Button Tag="Logs" Style="{StaticResource NavButton}" Content="≡  Activity Log" Click="Nav_Click"/>
                            <Button Tag="Settings" Style="{StaticResource NavButton}" Content="⚙  Settings" Click="Nav_Click"/>
                            <Button Tag="About" Style="{StaticResource NavButton}" Content="ⓘ  About" Click="Nav_Click"/>
                            <Border Margin="8,30,8,0" Padding="12" Background="#A51A3150" BorderBrush="#6A4F88A8" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="FOCUSED MODE" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                    <TextBlock Text="Monitor and wallpaper only" Foreground="{StaticResource Cyan}" Margin="0,5,0,0" FontSize="12"/>
                                    <TextBlock Text="No audio, window or taskbar modules" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,24">
                        <Grid>
                            <StackPanel x:Name="OverviewPanel">
                                <TextBlock Text="Overview" FontSize="27" FontWeight="SemiBold"/>
                                <TextBlock Text="Current monitor topology and wallpaper transaction" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,22"/>
                                <UniformGrid Columns="4">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="Status" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="OverviewStatus" Text="—" FontSize="21" Margin="0,12,0,0"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="Active monitors" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="MonitorCount" Text="0" FontSize="21" Margin="0,12,0,0"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="Matched profile" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="ProfileName" Text="Unmatched" FontSize="18" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="Match confidence" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="Confidence" Text="—" FontSize="21" Foreground="{StaticResource Cyan}" Margin="0,12,0,0"/></StackPanel>
                                    </Border>
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,18">
                                    <Button Content="Detect monitors" Click="Detect_Click"/>
                                    <Button Content="Reapply matched wallpapers" Click="Reapply_Click"/>
                                    <Button Content="Identify A/B/C" Click="Identify_Click"/>
                                </StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Latest status" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="LastMessage" Text="—" FontSize="16" TextWrapping="Wrap" Margin="0,9,0,5"/>
                                        <TextBlock x:Name="WallpaperTransactionText" Text="—" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Monitors and wallpapers" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,12"/>
                                <ItemsControl x:Name="MonitorItems">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Width="300" MinHeight="154">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Role}" Foreground="{StaticResource Cyan}" FontSize="14"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding Geometry}" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0"/>
                                                    <TextBlock Text="{Binding Wallpaper}" Foreground="{StaticResource Cyan}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="MonitorsPanel" Visibility="Collapsed">
                                <TextBlock Text="Monitor Identification" FontSize="27" FontWeight="SemiBold"/>
                                <TextBlock Text="Read hardware identity and current display information; this page never changes Windows display settings" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,18"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <Button Content="Detect monitors" Click="Detect_Click"/>
                                    <Button Content="Show A/B/C on each screen" Click="Identify_Click"/>
                                </StackPanel>
                                <ItemsControl x:Name="MonitorDetails">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Role}" Foreground="{StaticResource Cyan}" FontSize="14"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                        <TextBlock Text="{Binding Wallpaper}" Foreground="{StaticResource Cyan}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayInfo}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding ColorInfo}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                        <TextBlock Text="{Binding IdentityInfo}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Match evidence" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="MatchEvidence" Text="No match yet" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,9,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="LibraryPanel" Visibility="Collapsed">
                                <TextBlock Text="Wallpaper Library" FontSize="27" FontWeight="SemiBold"/>
                                <TextBlock Text="Managed wallpapers are stored in the SyncWallpaper folder on D:; click refresh after deleting files externally" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,18"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Import wallpapers" Click="ImportWallpaper_Click"/>
                                    <Button Content="Open wallpaper folder" Click="OpenWallpapers_Click"/>
                                    <Button Content="Refresh library" Click="RefreshLibrary_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="LibraryStatusText" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,18"/>
                                <ItemsControl x:Name="LibraryItems">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Width="292" MinHeight="116">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                                                    <TextBlock Text="{Binding Path}" Foreground="{StaticResource Cyan}" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="ProfilesPanel" Visibility="Collapsed">
                                <TextBlock Text="Wallpaper Profiles" FontSize="27" FontWeight="SemiBold"/>
                                <TextBlock Text="Each profile stores monitor identity, logical roles and wallpapers; profiles are matched automatically when topology changes" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,18"/>
                                <WrapPanel Margin="0,0,0,14">
                                    <TextBox x:Name="ProfileNameInput" Width="250" Height="39" VerticalContentAlignment="Center" Margin="0,0,10,8"/>
                                    <Button Content="Save current profile" Click="SaveCurrentProfile_Click" Margin="0,0,8,8"/>
                                    <Button Content="New blank profile" Click="CreateBlankProfile_Click" Margin="0,0,8,8"/>
                                    <Button Content="Edit selected profile" Click="EditProfile_Click" Margin="0,0,8,8"/>
                                    <Button Content="Apply selected profile" Click="ApplyProfile_Click" Margin="0,0,8,8"/>
                                    <Button Content="Rename" Click="RenameProfile_Click" Margin="0,0,8,8"/>
                                    <Button Content="Delete" Click="DeleteProfile_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <TextBlock x:Name="ProfileStatusText" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
                                <ListBox x:Name="ProfilesList" Background="Transparent" BorderThickness="0" SelectionChanged="ProfilesList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource GlassCardBackground}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Bindings}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                        <TextBlock Text="{Binding Details}" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding MatchText}" Foreground="{Binding MatchBrush}" FontWeight="SemiBold" Margin="18,2,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <StackPanel x:Name="LogsPanel" Visibility="Collapsed">
                                <TextBlock Text="Activity Log" FontSize="27" FontWeight="SemiBold"/>
                                <TextBlock Text="Records monitor detection, profile matching, wallpaper transactions and update checks" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,18"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button Content="Export read-only diagnostics" Click="ExportDiagnostic_Click"/>
                                    <Button Content="Open log folder" Click="OpenLogs_Click"/>
                                </StackPanel>
                                <ListBox x:Name="LogsList" Background="#78101C32" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Padding="8" MinHeight="430"/>
                            </StackPanel>

                            <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                                <TextBlock Text="Settings" FontSize="27" FontWeight="SemiBold"/>
                                <TextBlock Text="Wallpaper auto-matching, startup, resource usage and update checks" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,18"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Runtime" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <CheckBox x:Name="AutoMatchCheck" Content="Automatically match and apply wallpapers when monitor topology changes" Click="AutoMatch_Click" Margin="0,5"/>
                                        <CheckBox x:Name="StartupCheck" Content="Start automatically after Windows sign-in (keeps wallpaper recovery active)" Click="Startup_Click" Margin="0,5"/>
                                        <CheckBox x:Name="LowPerformanceCheck" Content="Low-resource mode (smaller render cache)" Click="LowPerformance_Click" Margin="0,5"/>
                                        <TextBlock Text="Data folder" Foreground="{StaticResource TextSecondary}" Margin="0,14,0,3"/>
                                        <TextBlock x:Name="DataPathText" Text="—" Foreground="{StaticResource Cyan}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Update checks" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Queries official GitHub Releases only; nothing is downloaded, installed or restarted automatically" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,12"/>
                                        <WrapPanel>
                                            <TextBlock Text="Current version" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock x:Name="CurrentVersionText" Text="—" Foreground="{StaticResource Cyan}" VerticalAlignment="Center" Margin="0,0,22,0"/>
                                            <TextBlock Text="Update channel" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <ComboBox x:Name="UpdateChannelCombo" Width="150" SelectionChanged="UpdateChannel_SelectionChanged">
                                                <ComboBoxItem Content="Stable" Tag="Stable"/>
                                                <ComboBoxItem Content="Beta" Tag="Beta"/>
                                            </ComboBox>
                                            <CheckBox x:Name="AutomaticUpdateCheck" Content="Check weekly" Click="AutomaticUpdateCheck_Click" VerticalAlignment="Center" Margin="18,0,0,0"/>
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,8">
                                            <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click"/>
                                            <Button x:Name="OpenReleaseButton" Content="Open Release page" Click="OpenRelease_Click"/>
                                            <TextBlock x:Name="LastUpdateCheckText" Text="Last check: never" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="UpdateStatusText" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="UpdateNotesText" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                                <TextBlock Text="About SyncWallpaper" FontSize="27" FontWeight="SemiBold"/>
                                <TextBlock Text="A Windows application focused exclusively on multi-monitor wallpapers" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,22"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="SyncWallpaper" FontSize="24" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AboutVersionText" Text="—" Foreground="{StaticResource Cyan}" Margin="0,8,0,18"/>
                                        <TextBlock Text="Core capabilities" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="• Identify monitors using EDID serials, device paths and hardware topology&#x0a;• Support identical models with A/B/C manual confirmation&#x0a;• Save, name, edit, delete and automatically apply wallpapers per monitor profile&#x0a;• Preserve complete read-only display data: resolution, refresh rate, HDR, DPI, orientation, coordinates and connector&#x0a;• Recover automatically after Explorer restart, hot-plug, lock and wake"
                                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="25" Margin="0,8,0,0"/>
                                        <TextBlock Text="This edition does not modify display settings and does not include audio, window management, taskbar, screen saver, remote or online wallpaper features."
                                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,20,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
