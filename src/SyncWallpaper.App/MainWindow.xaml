<Window x:Class="SyncWallpaper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SyncWallpaper.App"
        xmlns:core="clr-namespace:SyncWallpaper.Core;assembly=SyncWallpaper.Core"
        Title="屏序 SyncWallpaper" Width="1280" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" AllowsTransparency="True" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <DataTemplate x:Key="ThemePreview">
            <StackPanel>
                <Border Background="{Binding PreviewSurface}" CornerRadius="7" Padding="9" Height="68">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <Border Background="{Binding PreviewAccent}" Height="5" CornerRadius="2" Margin="0,3,0,6"/>
                            <Border Background="{Binding PreviewCard}" Height="4" CornerRadius="2" Margin="0,0,0,6"/>
                            <Border Background="{Binding PreviewCard}" Height="4" CornerRadius="2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Border Background="{Binding PreviewSecondary}" Height="4" Width="44" HorizontalAlignment="Left" CornerRadius="2" Margin="0,3,0,8"/>
                            <UniformGrid Columns="3">
                                <Border Background="{Binding PreviewCard}" Height="24" CornerRadius="4" Margin="0,0,4,0"/>
                                <Border Background="{Binding PreviewCard}" Height="24" CornerRadius="4" Margin="0,0,4,0"/>
                                <Border Background="{Binding PreviewCard}" Height="24" CornerRadius="4"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,4"/>
                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="ThemeTile" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Width" Value="124"/><Setter Property="Margin" Value="0,0,8,10"/>
            <Setter Property="ContentTemplate" Value="{StaticResource ThemePreview}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Tile" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="12">
                        <Grid>
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Border x:Name="SelectedMark" Background="{DynamicResource Cyan}" CornerRadius="5" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                                <TextBlock Text="✓" Foreground="{DynamicResource OnAccent}" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Cyan}"/><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="15,11"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TranslucentPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="WindowChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackground2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}"/>
        </Style>
        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowChromeButton}">
            <Setter Property="Background" Value="{DynamicResource PanelBackground2}"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="27"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
        <Style x:Key="PageDescription" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/><Setter Property="Margin" Value="0,0,0,22"/></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
        <Style x:Key="NavIcon" TargetType="Path"><Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/><Setter Property="StrokeThickness" Value="1.3"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Margin" Value="0,0,13,0"/></Style>
    </Window.Resources>

    <Border Margin="8" Background="{DynamicResource WindowSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <local:MysteryBackdrop Grid.RowSpan="2" IsHitTestVisible="False"/>
            <Border Grid.Row="0" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,0,0,1" Background="{DynamicResource TranslucentHeader}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="23,0,18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:BrandGlyph Width="44" Height="44" Margin="0,0,11,0"/>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="屏序" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="SyncWallpaper" FontSize="12" Foreground="{DynamicResource TextSecondary}"/></StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,7,0"/>
                        <TextBlock x:Name="StatusBadge" Text="正在启动" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <Button Style="{StaticResource WindowChromeButton}" Click="Minimize_Click" ToolTip="最小化"><Path Data="M3,8 H13" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"/></Button>
                        <Button Style="{StaticResource WindowChromeButton}" Click="Maximize_Click" ToolTip="最大化或还原"><Path Data="M3,3 H13 V13 H3 Z" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.3"/></Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="隐藏到托盘"><Path Data="M3,3 L13,13 M13,3 L3,13" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"/></Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource TranslucentSidebar}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,0,1,0">
                    <Grid Margin="13,24,13,22">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel x:Name="NavigationPanel">
                            <Button Tag="Overview" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M2,9 L10,2 18,9 M4,8 V18 H16 V8 M8,18 V12 H12 V18"/><TextBlock Text="概览"/></StackPanel></Button>
                            <Button Tag="Monitors" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M2,3 H18 V14 H2 Z M10,14 V18 M6,18 H14"/><TextBlock Text="显示器识别"/></StackPanel></Button>
                            <Button Tag="Library" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M2,2 H18 V18 H2 Z M2,14 L7,8 12,14 15,10 18,14 M12,6 H13"/><TextBlock Text="壁纸档案库"/></StackPanel></Button>
                            <Button Tag="Profiles" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M1,7 L10,2 19,7 10,12 Z M1,11 L10,16 19,11 M1,15 L10,20 19,15"/><TextBlock Text="壁纸组合"/></StackPanel></Button>
                            <Button Tag="Logs" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M7,4 H18 M7,10 H18 M7,16 H18 M2,4 H3 M2,10 H3 M2,16 H3"/><TextBlock Text="运行记录"/></StackPanel></Button>
                            <Border Height="1" Background="{DynamicResource GlassBorder}" Margin="14,20,14,16"/>
                            <Button Tag="Settings" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M1,5 H6 M11,5 H19 M1,15 H11 M16,15 H19 M6,2 H11 V8 H6 Z M11,12 H16 V18 H11 Z"/><TextBlock Text="设置"/></StackPanel></Button>
                            <Button Tag="About" Style="{StaticResource NavButton}" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M10,1 A9,9 0 1 1 9.99,1 M10,8 V15 M10,5 H10.1"/><TextBlock Text="关于"/></StackPanel></Button>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="12,0,8,0">
                            <local:BrandGlyph Width="30" Height="30" HorizontalAlignment="Left" Margin="0,0,0,6" Opacity="0.65"/>
                            <TextBlock Text="让每一屏，各就其位。" FontSize="12"/>
                            <TextBlock Text="显示器变化后，自动匹配壁纸。" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="17" Margin="0,3,0,6"/>
                            <Button x:Name="SidebarAutoMatchButton" Content="暂停自动匹配" Click="SidebarAutoMatch_Click" HorizontalAlignment="Left" Padding="0,5" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Cyan}" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid x:Name="OverviewPanel" Grid.Column="1" Margin="30,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="当前桌面" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="DesktopSummary" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                        <WrapPanel Margin="0,0,0,20"><Button Content="重新检测" Click="Detect_Click"/><Button Content="重新应用壁纸" Click="Reapply_Click" Style="{StaticResource PrimaryButton}"/><Button Content="识别 A/B/C" Click="Identify_Click"/><Button Content="编辑组合" Click="EditMatchedProfile_Click"/></WrapPanel>
                    </StackPanel>
                    <ScrollViewer x:Name="OverviewScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" Padding="0,0,8,0">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Padding="22,18,22,0">
                                <StackPanel>
                                    <Grid><TextBlock Text="屏幕排列" FontWeight="Medium"/><TextBlock x:Name="MonitorCount" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}"/></Grid>
                                    <local:MonitorTopologyView x:Name="TopologyView" Height="285" Margin="0,10,0,0"/>
                                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,1,0,0" Grid.ColumnSpan="2"/>
                                        <TextBlock Text="同一方向按桌面位置从左到右编号" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,10,12,10"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,4,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="18" BorderBrush="{DynamicResource Cyan}" BorderThickness="1" VerticalAlignment="Center"><TextBlock x:Name="MatchSymbol" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Cyan}" FontSize="18"/></Border>
                                <StackPanel Grid.Column="1" Margin="8,0,14,0"><TextBlock x:Name="OverviewStatus" FontSize="12"/><TextBlock x:Name="ProfileName" Text="未匹配" FontSize="17" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock x:Name="ConfidenceLabel" Foreground="{DynamicResource TextSecondary}" FontSize="12"/><TextBlock x:Name="Confidence" Foreground="{DynamicResource Cyan}" Text="—" Margin="0,5,0,0"/></StackPanel>
                            </Grid>
                            <Border BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,1,0,0" Padding="0,18,0,0"><StackPanel>
                                <TextBlock x:Name="LastMessage" Text="正在读取当前状态" TextWrapping="Wrap" FontSize="14"/>
                                <TextBlock x:Name="WallpaperTransactionText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"/>
                                <TextBlock Text="没有安全完整的特定匹配时，使用横屏与竖屏数量完全一致的通用组合。" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="22" Margin="0,18,0,0" FontSize="12"/>
                            </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="MonitorsPanel" Grid.Column="1" Visibility="Collapsed" Margin="30,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="显示器识别" Style="{StaticResource PageTitle}"/><TextBlock Text="每块屏幕的身份与位置，都有据可查。" Style="{StaticResource PageDescription}"/>
                            <WrapPanel Margin="0,0,0,20"><Button Content="重新检测" Click="Detect_Click"/><Button Content="在每个屏幕显示 A/B/C" Click="Identify_Click" Style="{StaticResource PrimaryButton}"/></WrapPanel>
                    </StackPanel>
                    <ScrollViewer x:Name="MonitorsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" Padding="0,0,8,0">
                        <StackPanel>
                            <ItemsControl x:Name="MonitorDetails"><ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,1,0,0" Padding="0,20" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0"><Border Height="105" Background="{DynamicResource InputBackground}" CornerRadius="5" ClipToBounds="True"><Image Source="{Binding Preview}" Stretch="UniformToFill"/></Border><TextBlock Text="{Binding SlotLabel}" Foreground="{DynamicResource Cyan}" FontSize="12" Margin="0,14,0,5"/><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Medium" TextWrapping="Wrap"/><TextBlock Text="{Binding Wallpaper}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,9,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Role}" Foreground="{DynamicResource Cyan}" Margin="0,0,0,10"/><TextBlock Text="{Binding DisplayInfo}" TextWrapping="Wrap" LineHeight="23"/><TextBlock Text="{Binding ColorInfo}" TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,12"/><Expander Header="查看完整硬件身份" Foreground="{DynamicResource TextSecondary}"><TextBox Text="{Binding IdentityInfo}" PreviewMouseWheel="NestedControl_PreviewMouseWheel" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="12" Margin="0,8,0,0"/></Expander></StackPanel>
                                </Grid></Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <Border BorderBrush="{DynamicResource Cyan}" BorderThickness="2,0,0,0" Padding="16,10" Margin="0,18,0,0"><StackPanel><TextBlock Text="匹配依据" FontSize="16"/><TextBlock x:Name="MatchEvidence" Text="尚未匹配" TextWrapping="Wrap" LineHeight="23" Foreground="{DynamicResource TextSecondary}" Margin="0,9,0,0"/></StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="LibraryPanel" Grid.Column="1" Visibility="Collapsed" Margin="30,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="壁纸档案库" Style="{StaticResource PageTitle}"/><TextBlock Text="为每块屏幕，留下一张合适的风景。" Style="{StaticResource PageDescription}"/>
                            <WrapPanel Margin="0,0,0,15"><Button Content="导入壁纸" Click="ImportWallpaper_Click" Style="{StaticResource PrimaryButton}"/><Button Content="打开壁纸目录" Click="OpenWallpapers_Click"/><Button Content="刷新档案库" Click="RefreshLibrary_Click"/></WrapPanel>
                            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock x:Name="LibraryStatusText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,18,0"/><TextBox x:Name="LibrarySearchText" Grid.Column="1" TextChanged="LibrarySearch_TextChanged" ToolTip="按壁纸名称搜索" AutomationProperties.Name="搜索壁纸"/></Grid>
                    </StackPanel>
                    <ScrollViewer x:Name="LibraryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" Padding="0,0,8,0">
                        <StackPanel>
                            <ItemsControl x:Name="LibraryItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                                <Button Tag="{Binding}" Click="PreviewWallpaper_Click" Width="220" Margin="0,0,15,20" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ToolTip="查看壁纸预览">
                                    <StackPanel><Border Height="132" Background="{DynamicResource InputBackground}" CornerRadius="6" ClipToBounds="True"><Image Source="{Binding Preview}" Stretch="UniformToFill"/></Border><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium" Margin="0,12,0,6" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Details}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Path}" Foreground="{DynamicResource TextDisabled}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock x:Name="LibraryEmptyText" Text="档案库里还没有壁纸。点击“导入壁纸”添加第一张图片。" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,22,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="LogsPanel" Grid.Column="1" Visibility="Collapsed" Margin="30,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="运行记录" Style="{StaticResource PageTitle}"/><TextBlock Text="每次检测、匹配与恢复，都留下清楚的记录。" Style="{StaticResource PageDescription}"/>
                            <WrapPanel Margin="0,0,0,22"><Button Content="导出只读诊断" Click="ExportDiagnostic_Click"/><Button Content="打开日志目录" Click="OpenLogs_Click"/></WrapPanel>
                    </StackPanel>
                    <ListBox x:Name="LogsList" Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate>
                                <Border BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,0,0,1" Padding="0,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{DynamicResource Cyan}" FontSize="12" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" LineHeight="22"/></Grid></Border>
                            </DataTemplate></ListBox.ItemTemplate></ListBox>
                </Grid>
                <Grid x:Name="SettingsPanel" Grid.Column="1" Visibility="Collapsed" Margin="30,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="设置" Style="{StaticResource PageTitle}"/><TextBlock Text="让屏序以你习惯的方式运行。" Style="{StaticResource PageDescription}"/>
                        <WrapPanel Margin="0,0,0,20"><Button x:Name="CheckUpdatesButton" Content="检查更新" Click="CheckUpdates_Click"/><Button x:Name="OpenReleaseButton" Content="打开发布页面" Click="OpenRelease_Click"/></WrapPanel>
                    </StackPanel>
                    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" Padding="0,0,8,0">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="298"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="运行方式" Style="{StaticResource SectionTitle}"/>
                                    <Border BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,1,0,1" Padding="0,17"><StackPanel><CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="AutoMatchCheck" Content="自动匹配与应用" Click="AutoMatch_Click"/><TextBlock Text="显示器组合变化时，查找并应用合适的壁纸。" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" FontSize="12" Margin="24,7,0,0"/></StackPanel></Border>
                                    <Border BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,0,0,1" Padding="0,17"><StackPanel><CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="StartupCheck" Content="随 Windows 启动" Click="Startup_Click"/><TextBlock Text="登录后恢复屏幕组合对应的壁纸。" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" FontSize="12" Margin="24,7,0,0"/></StackPanel></Border>
                                    <Border BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,0,0,1" Padding="0,17"><StackPanel><CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="LowPerformanceCheck" Content="低资源模式" Click="LowPerformance_Click"/><TextBlock Text="缩小渲染缓存和界面缩略图。" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" FontSize="12" Margin="24,7,0,0"/></StackPanel></Border>
                                    <TextBlock Text="更新检查" Style="{StaticResource SectionTitle}" Margin="0,28,0,16"/>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="AutomaticUpdateCheck" Content="每天自动检查新版本" Click="AutomaticUpdateCheck_Click"/>
                                    <TextBlock Text="发现新版时先询问你。同意后下载并重启更新，保留组合、壁纸和设置。" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" FontSize="12" Margin="24,7,0,20"/>
                                    <WrapPanel><TextBlock x:Name="CurrentVersionText" VerticalAlignment="Center" Margin="0,0,12,8" Foreground="{DynamicResource Cyan}"/><ComboBox x:Name="UpdateChannelCombo" Width="135" Margin="0,0,0,8" SelectionChanged="UpdateChannel_SelectionChanged" PreviewMouseWheel="NestedControl_PreviewMouseWheel"><ComboBoxItem Content="Stable 频道" Tag="Stable"/><ComboBoxItem Content="Beta 频道" Tag="Beta"/></ComboBox></WrapPanel>

                                    <TextBlock x:Name="LastUpdateCheckText" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="UpdateStatusText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,9,0,0"/><TextBlock x:Name="UpdateNotesText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top"><StackPanel><TextBlock Text="界面外观" Style="{StaticResource SectionTitle}"/><WrapPanel>
                                    <RadioButton x:Name="MysteryTheme" GroupName="UiTheme" Tag="Mystery" Content="{x:Static core:AppThemeCatalog.Mystery}" Style="{StaticResource ThemeTile}" Checked="Theme_Checked" AutomationProperties.Name="秘境主题"/>
                                    <RadioButton x:Name="AuroraTheme" GroupName="UiTheme" Tag="Aurora" Content="{x:Static core:AppThemeCatalog.Aurora}" Style="{StaticResource ThemeTile}" Checked="Theme_Checked" AutomationProperties.Name="极光科技主题"/>
                                    <RadioButton x:Name="GraphiteTheme" GroupName="UiTheme" Tag="Graphite" Content="{x:Static core:AppThemeCatalog.Graphite}" Style="{StaticResource ThemeTile}" Checked="Theme_Checked" AutomationProperties.Name="石墨暗色主题"/>
                                    <RadioButton x:Name="DaylightTheme" GroupName="UiTheme" Tag="Daylight" Content="{x:Static core:AppThemeCatalog.Daylight}" Style="{StaticResource ThemeTile}" Checked="Theme_Checked" AutomationProperties.Name="云白亮色主题"/>
                                </WrapPanel><TextBlock x:Name="ThemeHint" Foreground="{DynamicResource Cyan}" TextWrapping="Wrap" LineHeight="22" FontSize="12"/><Border Height="1" Background="{DynamicResource GlassBorder}" Margin="0,18"/><TextBlock Text="数据目录" FontSize="14"/><TextBlock x:Name="DataPathText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,9,0,0"/></StackPanel></Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="AboutPanel" Grid.Column="1" Visibility="Collapsed" Margin="30,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="关于屏序" Style="{StaticResource PageTitle}"/><TextBlock Text="多屏之间，延续你的桌面。" Style="{StaticResource PageDescription}"/>
                    </StackPanel>
                    <ScrollViewer x:Name="AboutScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" Padding="0,0,8,0">
                        <StackPanel>
                            <Grid Margin="0,15,0,35"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:BrandGlyph Width="96" Height="96" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="屏序 SyncWallpaper" FontSize="25" FontWeight="Medium"/><TextBlock x:Name="AboutVersionText" Foreground="{DynamicResource Cyan}" FontSize="14" Margin="0,9,0,0"/><TextBlock Text="一款专注多显示器壁纸的 Windows 应用。" Foreground="{DynamicResource TextSecondary}" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Grid>
                            <Border BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,1,0,0" Padding="0,24"><StackPanel><TextBlock Text="每块屏幕，都有自己的安排" Style="{StaticResource SectionTitle}"/><TextBlock Text="按显示器身份保存特定组合，也可以从空白创建通用组合。横屏与竖屏数量完全一致时，按桌面位置分配壁纸。" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="25"/></StackPanel></Border>
                            <Border BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,1,0,0" Padding="0,24"><StackPanel><TextBlock Text="连接改变，壁纸归位" Style="{StaticResource SectionTitle}"/><TextBlock Text="支持相同型号屏幕与 A/B/C 人工确认。开机、热插拔、锁屏、睡眠唤醒及 Explorer 重启后重新检测和恢复，保留完整只读显示信息。" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="25"/></StackPanel></Border>
                            <TextBlock Text="你的组合、壁纸与运行记录保存在本机。屏序不修改显示分辨率、刷新率、HDR 或桌面布局。" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="25" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="ProfilesPanel" Grid.Column="1" Visibility="Collapsed" Margin="30,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="壁纸组合" Style="{StaticResource PageTitle}"/><TextBlock Text="熟悉的屏幕各有安排，新的组合也能从容接替。" Style="{StaticResource PageDescription}"/>
                            <WrapPanel Margin="0,0,0,16"><Button Content="保存当前组合" Click="SaveCurrentProfile_Click"/><Button Content="新建通用组合" Click="CreateGenericProfile_Click" Style="{StaticResource PrimaryButton}"/><Button Content="新建空白特定组合" Click="CreateBlankProfile_Click"/></WrapPanel>
                            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ProfileStatusText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,18,0"/><ComboBox x:Name="ProfileFilterCombo" Grid.Column="1" Width="136" SelectionChanged="ProfileFilter_SelectionChanged" PreviewMouseWheel="ProfileFilter_PreviewMouseWheel" SelectedIndex="0"><ComboBoxItem Content="全部组合" Tag="all"/><ComboBoxItem Content="特定组合" Tag="specific"/><ComboBoxItem Content="通用组合" Tag="generic"/></ComboBox></Grid>
                            <Border BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,1,0,1" Padding="0,14,0,6" Margin="0,0,0,14"><StackPanel><TextBlock Text="选中组合" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,10"/><WrapPanel><TextBox x:Name="ProfileNameInput" Width="230" VerticalContentAlignment="Center" Margin="0,0,8,8" ToolTip="组合名称；用于保存当前组合或重命名"/><Button Content="重命名" Click="RenameProfile_Click" Margin="0,0,8,8"/><Button Content="应用选中组合" Click="ApplyProfile_Click" Margin="0,0,8,8"/><Button Content="编辑选中组合" Click="EditProfile_Click" Margin="0,0,8,8"/><Button Content="删除" Click="DeleteProfile_Click" Style="{StaticResource DangerButton}" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border>
                    </StackPanel>
                    <ListBox x:Name="ProfilesList" Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Background="Transparent" BorderThickness="0" SelectionChanged="ProfilesList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate>
                                <Border BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,0,0,1" Padding="8,17">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <local:ProfileKindGlyph x:Name="ProfileKindIcon" IsGeneric="{Binding IsGeneric}" Width="29" Height="29" VerticalAlignment="Top" Margin="0,4,14,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Medium" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding KindText}" Foreground="{Binding Stroke, ElementName=ProfileKindIcon}" FontSize="12" Margin="0,5,0,7"/>
                                            <TextBlock Text="{Binding Details}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" FontSize="12"/>
                                            <TextBlock Text="{Binding Bindings}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="20,0,0,0"><TextBlock Text="{Binding MatchText}" Foreground="{Binding MatchBrush}" HorizontalAlignment="Right"/><Button Content="编辑" Tag="{Binding Id}" Click="EditProfileRow_Click" Margin="0,12,0,0" Padding="12,6"/></StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate></ListBox.ItemTemplate></ListBox>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource Cyan}" BorderThickness="2,0,0,0" Padding="15,8" Margin="0,10,0,0"><TextBlock Text="先找安全完整的特定匹配，再核对通用组合。横屏、竖屏数量必须分别完全一致；缺少壁纸的位置保留当前壁纸。" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="23" FontSize="12"/></Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
