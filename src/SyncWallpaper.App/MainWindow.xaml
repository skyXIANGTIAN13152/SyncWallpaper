<Window x:Class="SyncWallpaper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:SyncWallpaper.Core;assembly=SyncWallpaper.Core"
        Title="SyncWallpaper" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" AllowsTransparency="True" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <DataTemplate x:Key="ThemePreview">
            <StackPanel>
                <Border Background="{Binding PreviewSurface}" CornerRadius="7" Padding="9" Height="68">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <Border Background="{Binding PreviewAccent}" Height="5" CornerRadius="2" Margin="0,3,0,6"/>
                            <Border Background="{Binding PreviewCard}" Height="4" CornerRadius="2" Margin="0,0,0,6"/>
                            <Border Background="{Binding PreviewCard}" Height="4" CornerRadius="2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Border Background="{Binding PreviewSecondary}" Height="4" Width="44" HorizontalAlignment="Left" CornerRadius="2" Margin="0,3,0,8"/>
                            <UniformGrid Columns="3">
                                <Border Background="{Binding PreviewCard}" Height="24" CornerRadius="4" Margin="0,0,4,0"/>
                                <Border Background="{Binding PreviewCard}" Height="24" CornerRadius="4" Margin="0,0,4,0"/>
                                <Border Background="{Binding PreviewCard}" Height="24" CornerRadius="4"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,4"/>
                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="ThemeTile" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Width" Value="206"/><Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="ContentTemplate" Value="{StaticResource ThemePreview}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Tile" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="12">
                        <Grid>
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Border x:Name="SelectedMark" Background="{DynamicResource Cyan}" CornerRadius="5" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                                <TextBlock Text="✓" Foreground="{DynamicResource OnAccent}" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Cyan}"/><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlassCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>
        <Style x:Key="WindowChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackground2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}"/>
        </Style>
        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowChromeButton}">
            <Setter Property="Background" Value="{DynamicResource PanelBackground2}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="10" Background="{DynamicResource WindowSurface}" BorderBrush="{DynamicResource GlassBorder}"
                BorderThickness="1" CornerRadius="18" Padding="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,0,0,1"
                        CornerRadius="18,18,0,0" Background="{DynamicResource HeaderBackground}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="24,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="46" Height="46" Margin="0,0,12,0">
                                <Ellipse Fill="{DynamicResource PanelBackground2}" Stroke="{DynamicResource Blue}" StrokeThickness="1" Margin="2"/>
                                <Ellipse Stroke="{DynamicResource Cyan}" StrokeThickness="1.8" Margin="7"/>
                                <Path Data="M5,23 C13,12 33,12 41,23 C33,34 13,34 5,23 Z"
                                      Fill="{DynamicResource AccentGradient}" Stroke="{DynamicResource Cyan}" StrokeThickness="1.2"/>
                                <Ellipse Width="14" Height="14" Fill="{DynamicResource InputBackground}" Stroke="{DynamicResource Cyan}" StrokeThickness="1.4"/>
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Cyan}"/>
                                <Ellipse Width="2" Height="2" Fill="White" Margin="2,0,0,2"/>
                            </Grid>
                            <StackPanel>
                                <TextBlock Text="SyncWallpaper" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Multi-monitor wallpaper detection, matching and recovery" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="{DynamicResource PanelBackground2}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1" CornerRadius="14" Padding="11,5">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Success}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusBadge" Text="Starting" Foreground="{DynamicResource Cyan}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource WindowChromeButton}" Margin="14,0,0,0" Click="Minimize_Click" ToolTip="Minimize">
                                <Path Data="M3,8 H13" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6"/>
                            </Button>
                            <Button Style="{StaticResource WindowChromeButton}" Click="Maximize_Click" ToolTip="Maximize or restore">
                                <Path Data="M3,3 H13 V13 H3 Z" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.45" Fill="Transparent"/>
                            </Button>
                            <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="Hide to tray">
                                <Path Data="M3,3 L13,13 M13,3 L3,13" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Height="2" VerticalAlignment="Bottom" Background="{DynamicResource AccentGradient}" Opacity="0.8" IsHitTestVisible="False"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="224"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="0,0,1,0" CornerRadius="0,0,0,18">
                        <StackPanel x:Name="NavigationPanel" Margin="12,22">
                            <TextBlock Text="WALLPAPER" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="12,0,0,10"/>
                            <Button Tag="Overview" Style="{StaticResource NavButton}" Content="⌂  Overview" Click="Nav_Click"/>
                            <Button Tag="Monitors" Style="{StaticResource NavButton}" Content="▣  Monitor Identification" Click="Nav_Click"/>
                            <Button Tag="Library" Style="{StaticResource NavButton}" Content="▧  Wallpaper Library" Click="Nav_Click"/>
                            <Button Tag="Profiles" Style="{StaticResource NavButton}" Content="⌁  Wallpaper Profiles" Click="Nav_Click"/>
                            <Button Tag="Logs" Style="{StaticResource NavButton}" Content="≡  Activity Log" Click="Nav_Click"/>
                            <Button Tag="Settings" Style="{StaticResource NavButton}" Content="⚙  Settings" Click="Nav_Click"/>
                            <Button Tag="About" Style="{StaticResource NavButton}" Content="ⓘ  About" Click="Nav_Click"/>
                            <Border Margin="8,30,8,0" Padding="12" Background="{DynamicResource GlassCardBackground}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="FOCUSED MODE" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                    <TextBlock Text="Monitor and wallpaper only" Foreground="{DynamicResource Cyan}" Margin="0,5,0,0" FontSize="12"/>
                                    <TextBlock Text="No audio, window or taskbar modules" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,24">
                        <Grid>
                            <StackPanel x:Name="OverviewPanel">
                                <TextBlock Text="Overview" FontSize="27" FontWeight="SemiBold"/>
                                <TextBlock Text="Current monitor topology and wallpaper transaction" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,22"/>
                                <UniformGrid Columns="4">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="Status" Foreground="{DynamicResource TextSecondary}"/><TextBlock x:Name="OverviewStatus" Text="—" FontSize="21" Margin="0,12,0,0"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="Active monitors" Foreground="{DynamicResource TextSecondary}"/><TextBlock x:Name="MonitorCount" Text="0" FontSize="24" Foreground="{DynamicResource Blue}" Margin="0,12,0,0"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="Matched profile" Foreground="{DynamicResource TextSecondary}"/><TextBlock x:Name="ProfileName" Text="Unmatched" FontSize="18" Foreground="{DynamicResource Purple}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="Match confidence" Foreground="{DynamicResource TextSecondary}"/><TextBlock x:Name="Confidence" Text="—" FontSize="21" Foreground="{DynamicResource Cyan}" Margin="0,12,0,0"/></StackPanel>
                                    </Border>
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,18">
                                    <Button Content="Detect monitors" Click="Detect_Click"/>
                                    <Button Content="Reapply matched wallpapers" Click="Reapply_Click" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="Identify A/B/C" Click="Identify_Click"/>
                                </StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Latest status" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock x:Name="LastMessage" Text="—" FontSize="16" TextWrapping="Wrap" Margin="0,9,0,5"/>
                                        <TextBlock x:Name="WallpaperTransactionText" Text="—" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Monitors and wallpapers" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,12"/>
                                <ItemsControl x:Name="MonitorItems">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Width="300" MinHeight="154">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Role}" Foreground="{DynamicResource Cyan}" FontSize="14"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding Geometry}" Foreground="{DynamicResource TextSecondary}" Margin="0,7,0,0"/>
                                                    <TextBlock Text="{Binding Wallpaper}" Foreground="{DynamicResource Cyan}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="MonitorsPanel" Visibility="Collapsed">
                                <TextBlock Text="Monitor Identification" FontSize="27" FontWeight="SemiBold"/>
                                <TextBlock Text="Read hardware identity and current display information; this page never changes Windows display settings" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,18"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <Button Content="Detect monitors" Click="Detect_Click"/>
                                    <Button Content="Show A/B/C on each screen" Click="Identify_Click"/>
                                </StackPanel>
                                <ItemsControl x:Name="MonitorDetails">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Role}" Foreground="{DynamicResource Cyan}" FontSize="14"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                        <TextBlock Text="{Binding Wallpaper}" Foreground="{DynamicResource Cyan}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayInfo}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding ColorInfo}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                        <TextBlock Text="{Binding IdentityInfo}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Match evidence" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="MatchEvidence" Text="No match yet" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,9,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="LibraryPanel" Visibility="Collapsed">
                                <TextBlock Text="Wallpaper Library" FontSize="27" FontWeight="SemiBold"/>
                                <TextBlock Text="Managed wallpapers are stored in the SyncWallpaper folder on D:; click refresh after deleting files externally" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,18"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Import wallpapers" Click="ImportWallpaper_Click" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="Open wallpaper folder" Click="OpenWallpapers_Click"/>
                                    <Button Content="Refresh library" Click="RefreshLibrary_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="LibraryStatusText" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,18"/>
                                <ItemsControl x:Name="LibraryItems">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Width="292" MinHeight="116">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Details}" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0"/>
                                                    <TextBlock Text="{Binding Path}" Foreground="{DynamicResource Cyan}" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="ProfilesPanel" Visibility="Collapsed">
                                <TextBlock Text="Wallpaper Profiles" FontSize="27" FontWeight="SemiBold"/>
                                <TextBlock Text="Each profile stores monitor identity, logical roles and wallpapers; profiles are matched automatically when topology changes" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,18" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,0,0,14">
                                    <TextBox x:Name="ProfileNameInput" Width="250" Height="39" VerticalContentAlignment="Center" Margin="0,0,10,8" ToolTip="Enter a profile name"/>
                                    <Button Content="Save current profile" Click="SaveCurrentProfile_Click" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="New blank profile" Click="CreateBlankProfile_Click" Margin="0,0,8,8"/>
                                    <Button Content="Edit selected profile" Click="EditProfile_Click" Margin="0,0,8,8"/>
                                    <Button Content="Apply selected profile" Click="ApplyProfile_Click" Margin="0,0,8,8"/>
                                    <Button Content="Rename" Click="RenameProfile_Click" Margin="0,0,8,8"/>
                                    <Button Content="Delete" Click="DeleteProfile_Click" Margin="0,0,8,8" Style="{StaticResource DangerButton}"/>
                                </WrapPanel>
                                <TextBlock x:Name="ProfileStatusText" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>
                                <ListBox x:Name="ProfilesList" Background="Transparent" BorderThickness="0" SelectionChanged="ProfilesList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource GlassCardBackground}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Bindings}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                        <TextBlock Text="{Binding Details}" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding MatchText}" Foreground="{Binding MatchBrush}" FontWeight="SemiBold" Margin="18,2,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <StackPanel x:Name="LogsPanel" Visibility="Collapsed">
                                <TextBlock Text="Activity Log" FontSize="27" FontWeight="SemiBold"/>
                                <TextBlock Text="Records monitor detection, profile matching, wallpaper transactions and update checks" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,18"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button Content="Export read-only diagnostics" Click="ExportDiagnostic_Click"/>
                                    <Button Content="Open log folder" Click="OpenLogs_Click"/>
                                </StackPanel>
                                <ListBox x:Name="LogsList" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1" Padding="8" MinHeight="430"/>
                            </StackPanel>

                            <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                                <TextBlock Text="Settings" FontSize="27" FontWeight="SemiBold"/>
                                <TextBlock Text="Appearance, automatic matching and preferences" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,18"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Switch instantly and save automatically. Inputs, dropdowns and selections use the same theme." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,18"/>
                                        <WrapPanel>
                                            <RadioButton x:Name="AuroraTheme" GroupName="UiTheme" Tag="Aurora" Content="{x:Static core:AppThemeCatalog.Aurora}" Style="{StaticResource ThemeTile}" Checked="Theme_Checked" AutomationProperties.Name="Aurora technology theme"/>
                                            <RadioButton x:Name="GraphiteTheme" GroupName="UiTheme" Tag="Graphite" Content="{x:Static core:AppThemeCatalog.Graphite}" Style="{StaticResource ThemeTile}" Checked="Theme_Checked" AutomationProperties.Name="Graphite dark theme"/>
                                            <RadioButton x:Name="DaylightTheme" GroupName="UiTheme" Tag="Daylight" Content="{x:Static core:AppThemeCatalog.Daylight}" Style="{StaticResource ThemeTile}" Checked="Theme_Checked" AutomationProperties.Name="Daylight light theme"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="ThemeHint" Foreground="{DynamicResource Cyan}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Runtime" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <CheckBox x:Name="AutoMatchCheck" Content="Automatically match and apply wallpapers when monitor topology changes" Click="AutoMatch_Click" Margin="0,5"/>
                                        <CheckBox x:Name="StartupCheck" Content="Start automatically after Windows sign-in (keeps wallpaper recovery active)" Click="Startup_Click" Margin="0,5"/>
                                        <CheckBox x:Name="LowPerformanceCheck" Content="Low-resource mode (smaller render cache)" Click="LowPerformance_Click" Margin="0,5"/>
                                        <TextBlock Text="Data folder" Foreground="{DynamicResource TextSecondary}" Margin="0,14,0,3"/>
                                        <TextBlock x:Name="DataPathText" Text="—" Foreground="{DynamicResource Cyan}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Update checks" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Queries official GitHub Releases only; nothing is downloaded, installed or restarted automatically" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,12"/>
                                        <WrapPanel>
                                            <TextBlock Text="Current version" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock x:Name="CurrentVersionText" Text="—" Foreground="{DynamicResource Cyan}" VerticalAlignment="Center" Margin="0,0,22,0"/>
                                            <TextBlock Text="Update channel" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <ComboBox x:Name="UpdateChannelCombo" Width="150" SelectionChanged="UpdateChannel_SelectionChanged">
                                                <ComboBoxItem Content="Stable" Tag="Stable"/>
                                                <ComboBoxItem Content="Beta" Tag="Beta"/>
                                            </ComboBox>
                                            <CheckBox x:Name="AutomaticUpdateCheck" Content="Check weekly" Click="AutomaticUpdateCheck_Click" VerticalAlignment="Center" Margin="18,0,0,0"/>
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,8">
                                            <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click"/>
                                            <Button x:Name="OpenReleaseButton" Content="Open Release page" Click="OpenRelease_Click"/>
                                            <TextBlock x:Name="LastUpdateCheckText" Text="Last check: never" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="UpdateStatusText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="UpdateNotesText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                                <TextBlock Text="About SyncWallpaper" FontSize="27" FontWeight="SemiBold"/>
                                <TextBlock Text="A Windows application focused exclusively on multi-monitor wallpapers" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,22"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="SyncWallpaper" FontSize="24" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AboutVersionText" Text="—" Foreground="{DynamicResource Cyan}" Margin="0,8,0,18"/>
                                        <TextBlock Text="Core capabilities" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="• Identify monitors using EDID serials, device paths and hardware topology&#x0a;• Support identical models with A/B/C manual confirmation&#x0a;• Save, name, edit, delete and automatically apply wallpapers per monitor profile&#x0a;• Preserve complete read-only display data: resolution, refresh rate, HDR, DPI, orientation, coordinates and connector&#x0a;• Recover automatically after Explorer restart, hot-plug, lock and wake"
                                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="25" Margin="0,8,0,0"/>
                                        <TextBlock Text="This edition does not modify display settings and does not include audio, window management, taskbar, screen saver, remote or online wallpaper features."
                                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,20,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
